{
  "name": "risejs-core",
  "version": "0.1.0-alpha.3",
  "description": "Web game framework for 3D, 2.5D and 2D games, built on three.js. Small core, opt-in packs, no runtime dependencies.",
  "homepage": "https://risejs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risejs/risejs.git"
  },
  "bugs": {
    "url": "https://github.com/risejs/risejs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "ISC",
  "type": "module",
  "main": "./src/rise/index.js",
  "module": "./src/rise/index.js",
  "exports": {
    ".": "./src/rise/index.js",
    "./dist": "./dist-lib/rise.js",
    "./style.css": "./src/ui.css",
    "./packs/*": "./src/rise/packs/*/index.js",
    "./packs/*/core": "./src/rise/packs/*/core.js",
    "./packs/physics/obb": "./src/rise/packs/physics/obb.js",
    "./packs/physics/heightfield": "./src/rise/packs/physics/heightfield.js",
    "./packs/physics/body": "./src/rise/packs/physics/body.js",
    "./packs/procgen": "./src/rise/packs/procgen/core.js",
    "./packs/gltf/manifest": "./src/rise/packs/gltf/manifest.js",
    "./packs/gltf/loader-info": "./src/rise/packs/gltf/loader-info.js",
    "./packs/sprite2d/sheet": "./src/rise/packs/sprite2d/sheet.js",
    "./packs/terrain/heightmap": "./src/rise/packs/terrain/heightmap.js",
    "./packs/assets/cache": "./src/rise/packs/assets/cache.js",
    "./packs/prefabs/instances": "./src/rise/packs/prefabs/instances.js",
    "./packs/prefabs/lod-group": "./src/rise/packs/prefabs/lod-group.js",
    "./packs/contracts/hash": "./src/rise/packs/contracts/hash.js",
    "./packs/contracts/diagnostics": "./src/rise/packs/contracts/diagnostics.js",
    "./packs/bakes/core": "./src/rise/packs/bakes/core.js",
    "./shared/*": "./src/shared/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/rise",
    "src/shared",
    "src/ui.css",
    "dist-lib",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "threejs",
    "game-framework",
    "webgl",
    "2d",
    "3d",
    "ecs-lite",
    "framework"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "preview": "vite preview",
    "format": "prettier --write src",
    "create-game": "node scripts/create-game.mjs",
    "server": "wrangler dev --local --port 8787 --persist-to C:/tmp/rise-state --config server/wrangler.toml",
    "server:test": "node server/test-ws.mjs",
    "server:migrate": "curl -X POST http://127.0.0.1:8787/api/admin/migrate",
    "test": "node scripts/test-core.mjs && npm run test:app && npm run test:packs && npm run test:games && npm run test:create",
    "test:create": "node --import ./scripts/css-stub-register.mjs scripts/test-create.mjs",
    "test:games": "node --import ./scripts/css-stub-register.mjs scripts/test-games.mjs",
    "test:packs": "node --import ./scripts/css-stub-register.mjs scripts/test-packs.mjs",
    "test:app": "node --import ./scripts/css-stub-register.mjs scripts/test-app.mjs",
    "test:e2e": "playwright test",
    "perf": "node scripts/bench-core.mjs",
    "audit": "node scripts/audit-packs.mjs",
    "api:surface": "node scripts/gen-api-surface.mjs",
    "api:check": "node scripts/check-api.mjs",
    "docs:api": "node scripts/gen-api-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "budget": "node scripts/check-boundary.mjs",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "make:glb": "node scripts/make-crate-glb.mjs",
    "server:test:zone": "node server/test-zone.mjs",
    "server:test:ac": "node server/test-anticheat.mjs",
    "make:map": "node scripts/make-map.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check:install": "node scripts/check-install.mjs"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "three": "^0.180.0",
    "vite": "^8.3.8",
    "wrangler": "^3.114.17"
  }
}
